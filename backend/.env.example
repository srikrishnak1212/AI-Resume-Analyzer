# ===================================
# Server Configuration
# ===================================
NODE_ENV=development
PORT=5000
API_VERSION=v1

# ===================================
# MongoDB Atlas
# ===================================
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ===================================
# JWT Secrets
# ===================================
JWT_ACCESS_SECRET=your-super-secret-access-token-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===================================
# Google Gemini AI
# ===================================
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-pro
GEMINI_FALLBACK_MODEL=gemini-1.5-flash

# ===================================
# File Storage (Cloudflare R2 / S3-compatible)
# ===================================
STORAGE_PROVIDER=local
# For Cloudflare R2:
# STORAGE_PROVIDER=r2
# R2_ACCOUNT_ID=your-r2-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET_NAME=ai-resume-analyser
# R2_PUBLIC_URL=https://your-bucket.r2.dev

# ===================================
# Email (Resend)
# ===================================
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=AI Resume Analyser

# ===================================
# Frontend URL (for CORS and emails)
# ===================================
FRONTEND_URL=http://localhost:5173

# ===================================
# Rate Limiting
# ===================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AI_MAX_REQUESTS=3
RATE_LIMIT_AUTH_MAX_REQUESTS=5

# ===================================
# Sentry Error Monitoring
# ===================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ===================================
# Redis Cache (Phase 2+)
# ===================================
# REDIS_URL=redis://localhost:6379
# UPSTASH_REDIS_REST_URL=https://your-upstash-redis-rest-url
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token
